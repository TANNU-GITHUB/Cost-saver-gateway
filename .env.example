# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8801
ADMIN_SECRET=change-me-admin-secret

# LLM provider (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SMALL_MODEL=gpt-4o-mini
LARGE_MODEL=gpt-4o
MOCK_LLM=true

# Semantic cache
REDIS_URL=redis://redis:6379/0
CACHE_SIMILARITY_HIGH=0.95
CACHE_SIMILARITY_LOW=0.80
CACHE_DEFAULT_TTL_SECONDS=86400
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Jev / TypeSafe
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_ENABLED=true
JEV_CONFIDENCE_THRESHOLD=0.85
MOCK_JEV=true

# Rate limits (default per API key)
DEFAULT_RATE_LIMIT_PER_HOUR=100
